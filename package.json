{
    "name": "staked-hemi",
    "version": "1.0.0",
    "repository": {
        "type": "git"
    },
    "scripts": {
        "format": "prettier --write 'src/**/*.sol'",
        "format:check": "prettier --check 'src/**/*.sol'",
        "lint": "solhint 'src/**/*.sol'",
        "lint:fix": "solhint 'src/**/*.sol' --fix",
        "check": "forge build && npm run lint && npm run format:check",
        "test": "forge test",
        "test:gas": "forge test --gas-report"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-foundry": "^1.2.0",
        "@nomicfoundation/hardhat-toolbox": "^6.1.0",
        "@openzeppelin/contracts": "5.3.0",
        "@openzeppelin/contracts-upgradeable": "5.3.0",
        "@types/node": "^20.12.7",
        "@typescript-eslint/eslint-plugin": "^7.7.1",
        "@typescript-eslint/parser": "^7.7.1",
        "compare-versions": "^6.1.0",
        "dotenv": "^16.6.1",
        "eslint": "^8.56.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.29.1",
        "forge-std": "https://github.com/foundry-rs/forge-std/tarball/v1.9.7",
        "hardhat": "^2.26.1",
        "hardhat-deploy": "^0.12.4",
        "hardhat-deploy-ethers": "^0.4.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "prettier": "^3.5.3",
        "prettier-plugin-solidity": "^1.4.3",
        "solc": "0.8.23",
        "solhint": "^4.5.4",
        "solhint-plugin-prettier": "0.1.0",
        "solidity-docgen": "0.6.0-beta.36"
    }
}
